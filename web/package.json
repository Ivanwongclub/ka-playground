{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && npm run ds2:check && npm run emoji:check && npm run test:marketing-payload && tsc -b && vite build && node scripts/bundle-budget.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-check.mjs",
    "ds2:check": "node scripts/ds2-tokens-check.mjs && node scripts/ds2-import-guard.mjs",
    "emoji:check": "node scripts/emoji-ban.mjs",
    "test:marketing-payload": "node scripts/marketing-payload.test.mjs",
    "fidelity": "node scripts/fidelity.mjs"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans-hk": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "antd": "^5.29.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
